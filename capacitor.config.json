{
  "appId": "com.example.huntmap",
  "appName": "HuntMap",
  "webDir": "www",
  "bundledWebRuntime": false,
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#0d1109"
  },
  "android": {
    "backgroundColor": "#0d1109",
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#e2801f",
      "sound": "beep.wav"
    }
  }
}

# HuntMap environment variables — copy to .env next to docker-compose.yml
# (docker compose reads it automatically) or paste the same keys into
# Portainer's stack environment editor.
#
# Every line is optional; the value after "=" is the default.

# ---------------------------------------------------------------- secrets/login
HUNTMAP_SECRET_KEY=change-me-to-a-long-random-string
HUNTMAP_ADMIN_USER=admin
HUNTMAP_ADMIN_PASSWORD=huntmap
HUNTMAP_ADMIN_EMAIL=

# ------------------------------------------------------------------------ ports
# Port on the Docker host you open in the browser.
HUNTMAP_PUBLISH_PORT=8443

# Port the server listens on *inside* the container. The compose mapping follows
# it, so changing it is enough — but remember:
#   * HUNTMAP_HTTPS=0  -> use 8000
#   * Cloudflare Tunnel -> the tunnel's Public Hostname must use the same port
HUNTMAP_PORT=8443

# Interface to bind. Leave 0.0.0.0 inside Docker: 127.0.0.1 would be unreachable
# through the published port and for a cloudflared sidecar. Handy when running
# serve.py/docker on a host behind a local reverse proxy.
#HUNTMAP_BIND=0.0.0.0

# Cloudflare Tunnel stack only: uncomment the "ports:" block in
# docker-compose.cloudflare.yml to also serve the app on your LAN (e.g. for
# uploads Cloudflare's 100 MB limit rejects), then set this host port.
#HUNTMAP_LAN_PORT=8000

# -------------------------------------------------------------------------- TLS
# 1 = HTTPS with a self-signed cert (needed for phone GPS), 0 = plain HTTP
# behind your own TLS proxy or a Cloudflare Tunnel.
HUNTMAP_HTTPS=1
# Make the generated certificate match your address:
#HUNTMAP_CERT_SAN=IP:192.168.1.50

# -------------------------------------------------------------------- behaviour
# ALLOWED_HOSTS (comma separated). Pin it when the app is on the internet.
#HUNTMAP_HOSTS=huntmap.example.com
# CSRF trusted origins, e.g. https://huntmap.example.com
#HUNTMAP_ORIGINS=
# Behind a TLS-terminating proxy / tunnel:
#HUNTMAP_PROXY_SSL=1
#HUNTMAP_FORWARDED_HOST=1
# Largest accepted map file in bytes (Cloudflare allows ~100 MB).
#HUNTMAP_MAX_UPLOAD=95000000
# Require X-HuntMap-Token for uploads and calibration writes:
#HUNTMAP_TOKEN=
HUNTMAP_TZ=UTC
HUNTMAP_WORKERS=1
HUNTMAP_THREADS=8

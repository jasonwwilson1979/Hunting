# HuntMap environment variables — copy to .env next to docker-compose.yml
# (docker compose reads it automatically) or paste the same keys into
# Portainer's stack environment editor.
#
# Every line is optional; the value after "=" is the default.

# ---------------------------------------------------------------- secrets/login
HUNTMAP_SECRET_KEY=change-me-to-a-long-random-string
HUNTMAP_ADMIN_USER=admin
HUNTMAP_ADMIN_PASSWORD=huntmap
HUNTMAP_ADMIN_EMAIL=

# ------------------------------------------------------------------------ ports
# Port on the Docker host you open in the browser.
# Leave this commented out to follow HUNTMAP_PORT (one setting for both sides).
#HUNTMAP_PUBLISH_PORT=8443

# Port the server listens on *inside* the container (8443 with TLS, 8000 for
# plain HTTP). Setting only this one moves the published port too.
#   * HUNTMAP_HTTPS=0  -> use 8000
#   * Cloudflare Tunnel -> the tunnel's Public Hostname must use the same port
HUNTMAP_PORT=8443

# Interface to bind. Leave 0.0.0.0 inside Docker: 127.0.0.1 would be unreachable
# through the published port and for a cloudflared sidecar. Handy when running
# serve.py/docker on a host behind a local reverse proxy.
#HUNTMAP_BIND=0.0.0.0

# Cloudflare Tunnel stack only: uncomment the "ports:" block in
# docker-compose.cloudflare.yml to also serve the app on your LAN (e.g. for
# uploads Cloudflare's 100 MB limit rejects), then set this host port.
#HUNTMAP_LAN_PORT=8000

# Plain-HTTP port that redirects to https (typing "ip:8443" without https:// is
# the most common reason a browser cannot connect). 0 disables it.
HUNTMAP_REDIRECT_PORT=8080
# Host port for that redirect listener (open http://<host>:8080/).
HUNTMAP_PUBLISH_HTTP_PORT=8080

# -------------------------------------------------------------------------- TLS
# 1 = HTTPS with a self-signed cert (needed for phone GPS), 0 = plain HTTP.
# Set 0 when Cloudflare (or another proxy) terminates TLS and points at
# http://<container>:<HUNTMAP_PORT> — the same pattern as your other apps.
HUNTMAP_HTTPS=1
# Make the generated certificate match your address:
#HUNTMAP_CERT_SAN=IP:192.168.1.50

# -------------------------------------------------------------------- behaviour
# ALLOWED_HOSTS (comma separated). Pin it when the app is on the internet.
#HUNTMAP_HOSTS=huntmap.example.com
# CSRF trusted origins, e.g. https://huntmap.example.com
#HUNTMAP_ORIGINS=
# Behind a TLS-terminating proxy / tunnel:
#HUNTMAP_PROXY_SSL=1
#HUNTMAP_FORWARDED_HOST=1
# Largest accepted map file in bytes (Cloudflare allows ~100 MB).
#HUNTMAP_MAX_UPLOAD=95000000
# Require X-HuntMap-Token for uploads and calibration writes:
#HUNTMAP_TOKEN=
# 1 = only signed-in accounts see the library (own maps + shared ones)
HUNTMAP_REQUIRE_AUTH=0
HUNTMAP_TZ=UTC
HUNTMAP_WORKERS=1
HUNTMAP_THREADS=8

# ------------------------------------------------- self-hosted map tiles (licensing)
# Read "Self-hosted base maps" in README.md before opening the site to the public.
# The app can draw base maps from this server instead of community tile servers.
# Tiles live on the /data volume, so they survive restarts/updates.
HUNTMAP_TILES_DIR=/data/tiles
# Or serve an .mbtiles archive instead of a folder (raster MBTiles):
#HUNTMAP_TILES_MBTILES=/data/tiles/region.mbtiles
# Or point at your own tile server (renderd, tileserver-gl, a CDN in front of the
# folder above). Takes precedence over both settings above.
#HUNTMAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# Highest zoom your tiles have; the app stops there instead of asking for 404s.
HUNTMAP_TILE_MAXZOOM=16
# Credit shown on the map. Empty = "© OpenStreetMap contributors".
#HUNTMAP_TILE_ATTRIBUTION=
#HUNTMAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright

# 1 = paid/public-site mode: hide base maps whose licence does not fit commercial
# use (Esri, the community OSM and OpenTopoMap tile servers). Set this before you
# charge anybody for access.
HUNTMAP_COMMERCIAL=0

# ------------------------------------------------------ native app (iOS/Android)
# Origins allowed to call /api/ cross-origin (Capacitor shells) and to receive a
# bearer token from POST /api/token/.
HUNTMAP_NATIVE_ORIGINS=capacitor://localhost,ionic://localhost,https://localhost,http://localhost
# How long a device token lasts (0 = never expires).
HUNTMAP_TOKEN_DAYS=365
